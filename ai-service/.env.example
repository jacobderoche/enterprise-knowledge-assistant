# Provider selection: offline | openai | anthropic
LLM_PROVIDER=offline
EMBEDDING_PROVIDER=offline

# Required only when using real providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# Vector store: leave DATABASE_URL empty to use the in-memory store
# DATABASE_URL=postgresql://app:app@postgres:5432/knowledge

# Retrieval tuning
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Observability
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LANGSMITH_TRACING=false
# LANGCHAIN_API_KEY=ls-...
